# ─────────────────────────────────────────────────────────────────────────
# Portable runtime & vendored third-party tools — fetched by bootstrap.
# These are large (python ~67MB, tools ~13MB) and are NOT part of the source.
# ─────────────────────────────────────────────────────────────────────────
/python/
/tools/

# ─────────────────────────────────────────────────────────────────────────
# Portable MariaDB test lab — binaries (~400MB unpacked) fetched by
# testlab/setup_mysql_lab.bat, plus its generated data dir. NOT source; the
# vuln app (testlab/vuln_mysql_server.py) + control script are tracked, the
# server binaries and database files are not.
# ─────────────────────────────────────────────────────────────────────────
/testlab/mariadb/
/testlab/mysql-data/

# ─────────────────────────────────────────────────────────────────────────
# Runtime state — created on first run. MUST NEVER be published: the SQLite
# DB holds your real scan history, data/requests/ stores the raw HTTP requests
# you tested (cookies, Authorization headers, session tokens), data/logs/ holds
# engine output, and settings.json may hold host/port/toggles.
# ─────────────────────────────────────────────────────────────────────────
/data/

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# ── uv self-contained runtime (all created INSIDE the project by start.bat) ──
# Large + machine-specific, so not source. uv.lock and requirements.txt ARE
# tracked (they make these reproducible) -- do NOT add them here.
#   .tools/          = uv.exe (downloaded once, no system install)
#   .python-managed/ = uv-managed CPython
#   .uv-cache/       = uv package cache (self-contained strategy)
/.tools/
/.python-managed/
/.uv-cache/

# ── Archives / backups (never commit a zip of the project) ──
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# ── vendored/downloaded skill package (installed to ~/.claude/skills instead) ──
/code-review-skill-main/

# ── Editor / OS ──
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
